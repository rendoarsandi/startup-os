{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startup-os",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_DO",
        "class_name": "AutomationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceDO"
      ]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "WorkspaceDO",
          "to": "AutomationCoordinator"
        }
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "startup-os-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
