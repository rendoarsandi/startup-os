# Local Vite and Node development; Cloudflare uses wrangler secrets / .dev.vars.
BETTER_AUTH_URL=http://localhost:3000
# Set a strong random value in production. Local development creates one in .data.
BETTER_AUTH_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional Gemini provider, used when OpenRouter is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
