{
  "name": "startup-os",
  "private": true,
  "packageManager": "npm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "deploy": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "test": "vitest run --config vitest.config.ts",
    "generate-routes": "node generate-routes.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:migrate:local",
    "typecheck": "tsc -b",
    "dev:cloudflare": "CF_BUILD=1 vite dev --port 3000",
    "build:cloudflare": "CF_BUILD=1 vite build",
    "db:migrate:local": "wrangler d1 migrations apply startup-os-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply startup-os-db --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.20.5",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.12.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.0.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/ai": "^0.65.1",
    "@tanstack/ai-gemini": "^0.36.0",
    "zod": "^4.4.3",
    "@openrouter/sdk": "0.13.20",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.0",
    "@eslint/js": "^10.0.1",
    "@oxlint/binding-android-arm64": "^1.78.0",
    "@oxlint/plugins": "^1.78.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/intent": "^0.3.6",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.78.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.54.0",
    "@cloudflare/workers-types": "^5.20261008.1"
  },
  "overrides": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3",
    "esbuild": "^0.25.0",
    "jsondiffpatch": "^0.7.2",
    "@ai-sdk/provider-utils": "^4.0.0",
    "@tanstack/form-core": "^1.33.2",
    "turbo-stream": "^3.0.0",
    "sharp": "^0.35.5"
  }
}
